# Enquiry email delivery (https://resend.com)
# Without both of these the form returns a clear 503 rather than pretending to send.
RESEND_API_KEY=

# Verified sender on your Resend domain, e.g. "Go Below <enquiries@gobelow.co.uk>"
ENQUIRY_FROM=

# The destination inbox is NOT an env var — set `email` in src/lib/site.ts,
# alongside the other company facts, so there is one place to look.
